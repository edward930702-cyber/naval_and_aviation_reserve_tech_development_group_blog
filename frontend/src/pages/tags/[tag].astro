---
import '../../styles/global.css';

const { tag } = Astro.params;
const decodedTag = tag ? decodeURIComponent(tag) : '';

let filteredPosts = [];

try {
  // 直接透過 Docker 內部網路存取後端 API
  const res = await fetch('http://backend:3000/api/posts');
  if (res.ok) {
    const rawPosts = await res.json();
    
    // 解析並篩選出包含當前 tag 的文章
    const posts = Array.isArray(rawPosts) ? rawPosts.map(p => ({
      slug: p.slug || '',
      title: p.data?.title || p.slug || '無標題',
      category: p.data?.category || 'Reserve (DevOps)',
      description: p.data?.description || '',
      pubDate: p.data?.pubDate ? new Date(p.data.pubDate) : new Date(),
      tags: Array.isArray(p.data?.tags) ? p.data.tags : []
    })).sort((a, b) => b.pubDate - a.pubDate) : [];

    filteredPosts = posts.filter(p => p.tags.includes(decodedTag));
  }
} catch (err) {
  console.error('SSR 抓取標籤文章失敗:', err);
}
---

<html lang="zh-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>標籤: #{decodedTag} // 海空軍預備技術開發群</title>
  </head>
  <body class="bg-[#030712] text-slate-200 font-mono min-h-screen p-6 md:p-12">
    <div class="max-w-4xl mx-auto space-y-8">
      
      <!-- 返回首頁按鈕 -->
      <a href="/" class="inline-flex items-center gap-2 text-xs md:text-sm text-emerald-400 hover:text-emerald-300 transition">
        &larr; 返回首頁 (RETURN TO BASE)
      </a>

      <header class="border-b border-slate-800/80 pb-6 space-y-2">
        <h1 class="text-2xl md:text-3xl font-bold text-white tracking-wide">
          // 標籤篩選: <span class="text-emerald-400">#{decodedTag}</span>
        </h1>
        <p class="text-xs text-slate-500">
          共找到 {filteredPosts.length} 篇相關戰術日誌
        </p>
      </header>

      <main class="space-y-6">
        {filteredPosts.length > 0 ? (
          filteredPosts.map(post => (
            <article class="p-6 bg-slate-900/30 border border-slate-800/80 rounded-xl hover:border-slate-700 transition space-y-3">
              <div class="flex justify-between items-start">
                <span class="text-xs px-3 py-1 bg-emerald-950/60 text-emerald-400 border border-emerald-800/40 rounded-md font-medium">
                  {post.category}
                </span>
                <time class="text-xs text-slate-500">
                  {post.pubDate.toISOString().split('T')[0]}
                </time>
              </div>
              <h2 class="text-lg md:text-xl font-bold text-slate-100 hover:text-emerald-400 transition">
                <a href={`/posts/${post.slug}`}>{post.title}</a>
              </h2>
              <p class="text-sm text-slate-400 line-clamp-2 leading-relaxed">
                {post.description || '點擊進入檢視詳細戰術評估與程式碼實作。'}
              </p>
              <div class="flex gap-3 pt-2">
                {post.tags.map(t => (
                  <span class={`text-xs ${t === decodedTag ? 'text-emerald-400 font-bold' : 'text-slate-500'}`}>
                    #{t}
                  </span>
                ))}
              </div>
            </article>
          ))
        ) : (
          <div class="p-12 text-center text-sm text-slate-600 border border-dashed border-slate-800/80 rounded-xl">
            找不到包含標籤 #{decodedTag} 的文章
          </div>
        )}
      </main>

    </div>
  </body>
</html>